# =============================================================================
# SAIE — Environment Configuration Template
# Copy this file to `.env` at the project root and fill in real values.
# Never commit the real `.env` — it is gitignored (see `.gitignore`).
# =============================================================================

# --- Brevo Transactional Email (docs/24) ------------------------------------
# Your Brevo API key (https://app.brevo.com/settings/keys/api).
BREVO_API_KEY=your-brevo-api-key-here

# A sender address VERIFIED in your Brevo account (Sender tab). Unverified
# senders cause HTTP 403 "sender not verified".
BREVO_SENDER_EMAIL=verified-sender@example.com

# Display name shown as the sender.
BREVO_SENDER_NAME=SAIE Weekly Report

# Recipient of the Saturday intelligence report PDF.
REPORT_RECIPIENT_EMAIL=recipient@example.com

# SAFETY SWITCH — dry-run performs full validation but sends NO email.
# Set to false ONLY when you are ready to send real email.
#   true  → validate + report what would be sent (default)
#   false → actually send via the Brevo API
EMAIL_DRY_RUN=true

# --- LLM providers (used by later modules; placeholders) ---------------------
# OPEN_API_KEY=
# GEMINI_API_KEY=
