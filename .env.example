# =============================================================================
# SAIE — Environment Configuration Template
# Copy this file to `.env` at the project root and fill in real values.
# Never commit the real `.env` — it is gitignored (see `.gitignore`).
# =============================================================================

# --- M01 — Project Foundation (NFR-004, NFR-005, NFR-006) -------------------
APP_NAME=saie-api
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional OTLP collector endpoint. Leave empty to disable remote export
# (spans go to a no-op pipeline; useful in dev or test).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=saie

# --- Brevo Transactional Email (docs/24) ------------------------------------
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=SAIE Weekly Report
REPORT_RECIPIENT_EMAIL=recipient@example.com
EMAIL_DRY_RUN=true

# --- LLM providers (used by later modules; placeholders) ---------------------
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Database / Cache / Vector / Graph / Object store (M03; placeholders) ---
# POSTGRES_PASSWORD=
# NEO4J_PASSWORD=
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=

# --- Identity (M02; placeholders) -------------------------------------------
# KEYCLOAK_ADMIN_PASSWORD=
# SECRET_KEY=
